; D-Island installer (Inno Setup 6). Build with tools\build-installer.ps1, which publishes the app and
; passes AppVersion, PublishDir and IconFile.
;
; Per-user install (no admin): %LocalAppData%\Programs\D-Island. Self-contained (.NET included).
; The wizard shows "How to use D-Island" (HowToUse.rtf) before installing; the Start menu gets the
; same guide as HowToUse.html.

#ifndef AppVersion
  #define AppVersion "1.0.0"
#endif
#ifndef PublishDir
  #define PublishDir "..\artifacts\publish"
#endif
#ifndef IconFile
  #define IconFile "..\DIsland.ico"
#endif

[Setup]
AppId={{8C8B6A43-7E0B-4C55-9A0E-2B5D0E4F7A11}
AppName=D-Island
AppVersion={#AppVersion}
AppVerName=D-Island {#AppVersion}
AppPublisher=ibuildrigs
AppPublisherURL=https://ibuildrigs.com
AppSupportURL=https://github.com/H7gamer/d-island/issues
AppUpdatesURL=https://github.com/H7gamer/d-island/releases
AppCopyright=Copyright (c) 2026 h7 (ibuildrigs). Licensed under the D-Island License 1.0.
AppComments=A Dynamic Island for Windows. Built by h7.
AppContact=https://ibuildrigs.com
VersionInfoCompany=ibuildrigs
VersionInfoCopyright=Copyright (c) 2026 h7 (ibuildrigs). Licensed under the D-Island License 1.0.
VersionInfoDescription=D-Island setup
; The D-Island License, which the user must accept; NOTICE.txt (official sources, required credit) is
; installed next to it and linked from Settings > About.
LicenseFile=..\LICENSE.txt
DefaultDirName={localappdata}\Programs\D-Island
DisableProgramGroupPage=yes
DisableDirPage=auto
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.19041
OutputDir=..\artifacts
OutputBaseFilename=D-Island-Setup-{#AppVersion}
SetupIconFile={#IconFile}
UninstallDisplayIcon={app}\DIsland.exe
UninstallDisplayName=D-Island
WizardStyle=modern
WizardSizePercent=110
; Generated by tools\build-installer.ps1 (1x and 2x for high-DPI screens).
WizardSmallImageFile=wizard-small.bmp,wizard-small-2x.bmp
WizardImageFile=wizard-large.bmp,wizard-large-2x.bmp
Compression=lzma2/ultra64
SolidCompression=yes
InfoBeforeFile=HowToUse.rtf
; The running island is closed in PrepareToInstall / InitializeUninstall below.
CloseApplications=no
#ifdef Sign
; Code signing (tools\build-installer.ps1 passes /DSign and the "disland" sign tool when a certificate
; is configured): signs the setup and the uninstaller.
SignTool=disland
SignedUninstaller=yes
#endif

[Messages]
WizardLicense=License agreement
LicenseLabel=You may use, modify and share D-Island, as long as you credit its author, respect people's privacy and never use it to harm anyone. Official releases come only from github.com/H7gamer/d-island and ibuildrigs.com.
LicenseLabel3=Please read the license. You must accept it to install D-Island.
LicenseAccepted=I &accept the agreement
LicenseNotAccepted=I &do not accept the agreement
WizardInfoBefore=How to use D-Island
InfoBeforeLabel=A quick tour of what D-Island does and how to use it. You can read it again later from the Start menu (How to use D-Island).
InfoBeforeClickLabel=When you're ready, click Next.
FinishedHeadingLabel=D-Island is ready
FinishedLabelNoIcons=D-Island has been installed. Look for it at the top of your screen.%n%nBuilt by h7 - ibuildrigs.com
FinishedLabel=D-Island has been installed. Look for it at the top of your screen, or start it from the Start menu.%n%nBuilt by h7 - ibuildrigs.com

[Tasks]
Name: "startup"; Description: "Start D-Island when I sign in to Windows"; GroupDescription: "Options:"
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Options:"; Flags: unchecked
Name: "identity"; Description: "Set up notifications and the Windows calendar now. Downloads Microsoft's packaging tools (about 100 MB, once); Windows asks for permission once. You can also do this later in Settings."; GroupDescription: "Optional:"; Flags: unchecked

[Files]
Source: "{#PublishDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "HowToUse.html"; DestDir: "{app}"; Flags: ignoreversion
; Shown on the privacy page during setup (extracted on demand); also installed (via the publish folder).
Source: "..\PRIVACY.txt"; Flags: dontcopy

[Icons]
Name: "{autoprograms}\D-Island"; Filename: "{app}\DIsland.exe"; Comment: "A Dynamic Island for Windows"
Name: "{autoprograms}\D-Island Settings"; Filename: "{app}\DIsland.exe"; Parameters: "--settings"; Comment: "Open D-Island's settings"
Name: "{autoprograms}\How to use D-Island"; Filename: "{app}\HowToUse.html"; Comment: "The D-Island guide"
Name: "{autoprograms}\D-Island Privacy"; Filename: "{app}\PRIVACY.txt"; Comment: "What D-Island processes (LICENSE.txt and NOTICE.txt are in the same folder)"
Name: "{autodesktop}\D-Island"; Filename: "{app}\DIsland.exe"; Tasks: desktopicon

[Registry]
; The same value D-Island's own "Start with Windows" setting uses (Services\StartupManager.cs).
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "DIsland"; ValueData: """{app}\DIsland.exe"""; Tasks: startup; Flags: uninsdeletevalue

[Run]
Filename: "powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\Identity\setup-identity.ps1"""; StatusMsg: "Setting up notifications and the Windows calendar (Windows may ask for permission)..."; Tasks: identity; Flags: runhidden waituntilterminated
Filename: "{app}\DIsland.exe"; Description: "Start D-Island now"; Flags: nowait postinstall skipifsilent
; Automatic updates run this installer silently (from D-Island's updater): reopen the island afterwards.
Filename: "{app}\DIsland.exe"; Flags: nowait; Check: WizardSilent
Filename: "{app}\HowToUse.html"; Description: "Open the guide"; Flags: postinstall shellexec skipifsilent unchecked

[UninstallRun]
; The identity package (if it was set up) and its signing key in the user's certificate store. The
; machine-wide trust entry needs admin rights and is left; without the key it can't sign anything.
Filename: "powershell.exe"; Parameters: "-NoProfile -Command ""Get-AppxPackage -Name DIsland | Remove-AppxPackage; Get-ChildItem Cert:\CurrentUser\My | Where-Object Subject -eq 'CN=D-Island Dev' | Remove-Item"""; Flags: runhidden; RunOnceId: "RemoveIdentity"

[Code]
{ After the licence: what D-Island processes (PRIVACY.txt), before the how-to guide. Plus
  "Built by h7 - ibuildrigs.com" at the bottom-left of every wizard page, beside the buttons. }
procedure InitializeWizard();
var
  Credit: TNewStaticText;
  Privacy: TOutputMsgMemoWizardPage;
  Text: AnsiString;
begin
  ExtractTemporaryFile('PRIVACY.txt');
  LoadStringFromFile(ExpandConstant('{tmp}\PRIVACY.txt'), Text);
  Privacy := CreateOutputMsgMemoPage(wpLicense, 'Privacy',
    'What D-Island reads on your computer, what it sends over the internet, and what it stores.',
    'In short: no accounts, analytics or tracking. Almost everything stays on your computer. Every feature can be turned off in Settings.',
    String(Text));

  Credit := TNewStaticText.Create(WizardForm);
  Credit.Parent := WizardForm;
  Credit.Caption := 'Built by h7 - ibuildrigs.com';
  Credit.Font.Color := clGrayText;
  Credit.Left := ScaleX(16);
  Credit.Top := WizardForm.CancelButton.Top + (WizardForm.CancelButton.Height - Credit.Height) div 2;
  Credit.Anchors := [akLeft, akBottom];
end;

procedure CloseIsland();
var
  ResultCode: Integer;
begin
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/f /im DIsland.exe', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Sleep(400);
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  CloseIsland();
  Result := '';
end;

function InitializeUninstall(): Boolean;
begin
  CloseIsland();
  Result := True;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if (CurUninstallStep = usPostUninstall) and not UninstallSilent then
    if MsgBox('Also delete your D-Island settings and saved data (to-do list, notes, shelf, cached artwork)?', mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
    begin
      DelTree(ExpandConstant('{userappdata}\DIsland'), True, True, True);
      DelTree(ExpandConstant('{localappdata}\DIsland'), True, True, True);
    end;
end;
