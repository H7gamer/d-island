<?xml version="1.0" encoding="utf-8"?>
<!-- Sparse package: gives the plain DIsland.exe (in the registered external location) a package identity,
     which Windows requires for reading notifications (UserNotificationListener) and the Windows calendar
     (AppointmentStore). Nothing is installed or moved; see setup-identity.ps1. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="DIsland" Publisher="CN=D-Island Dev" Version="1.0.0.0" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>D-Island</DisplayName>
    <PublisherDisplayName>D-Island</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
    <uap:Capability Name="appointments" />
  </Capabilities>
  <Applications>
    <!-- win32App: runs as an ordinary desktop app (no file/registry virtualization). AppListEntry none:
         no second Start menu entry. -->
    <Application Id="DIsland" Executable="DIsland.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="D-Island" Description="Dynamic Island for Windows" BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
                          AppListEntry="none" />
    </Application>
  </Applications>
</Package>
